# Manifest for pkg/sep2tls/gotls files that check-upstream.sh cannot verify
# by diffing against upstream crypto/tls, because they have no upstream
# counterpart (fork-only) or have deliberately diverged from it (patched).
#
# Format: type<TAB>path<TAB>sha256<TAB>note
#   type: fork-only | patched
#   path: relative to pkg/sep2tls/gotls
#   sha256: sha256sum of the file's current raw content
#   note: why the file exists or diverges (free text, no tabs)
#
# To add or update an entry after changing a listed file:
#   sha256sum pkg/sep2tls/gotls/<path>
# and replace the hash on its line (or add a new line, keeping the
# tab-separated columns). See UPSTREAM.md, "Recording a deliberate change".
fork-only	cipher_suites_ccm.go	09dd1f1925d4162255c5df1f2e3d21067e2cbc70b89f7d8bb9e5d3283413211b	CCM-8 cipher suite registration; no upstream file
fork-only	ccm_check_test.go	c03c4467e9ce78e696910f02175e9826c33a9c5364d40255647237ec66b38436	fork-only test, asserts CCM-8 is registered
fork-only	ccm_raw_test.go	25109d9a487b9caa889c8afcfd64f7e171c56107cba50a19bcd036a56283997b	fork-only test, raw handshake using CCM-8
fork-only	stubs/boring/boring.go	91b92ebe231b874fc628713111aceb90f226d1bf4f11a1db6eb4a107295a610d	stand-in for crypto/internal/boring
fork-only	stubs/cpu/cpu.go	c09a4ea57efdf8996c733ce647a4cbaaa1dafb0ee4b5f0b8e72919a815de4f74	stand-in for internal/cpu
fork-only	stubs/fipstls/fipstls.go	65e84ade9026ef59cfd49d65d248366ebbd64579aff9e7112b820ebf363fadfc	stand-in for crypto/internal/boring/fipstls
fork-only	stubs/godebug/godebug.go	97cbd3567dced246328a9e5a456d086779d6f7d0f2ef83b9442032e80397ce5a	stand-in for internal/godebug
